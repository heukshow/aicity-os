# SheetProof v0.3+
# Payment / analytics keys will be added only after public-use validation.
APP_ENV=development
MAX_UPLOAD_MB=10

# Comma-separated list of exact frontend origins allowed to call this API
# from a browser (CORS). Leave empty/unset while no public frontend domain
# is wired up yet -- no CORS middleware is installed in that case, so
# cross-origin browser requests stay blocked by default.
# Example once the frontend domain is known:
# ALLOWED_ORIGINS=https://cosuma.co.kr,https://sheetproof-git-preview.vercel.app
ALLOWED_ORIGINS=
